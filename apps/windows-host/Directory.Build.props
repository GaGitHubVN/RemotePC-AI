<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Noise-only rules for this codebase: logging perf hints, localization of exception text, ConfigureAwait in app code -->
    <NoWarn>$(NoWarn);CA1848;CA1303;CA2007;CA1031;CA1305;CA1307;CA1310;CA1716;CA1515;CA1062</NoWarn>
    <Version>0.3.0</Version>
    <Authors>RemotePC AI</Authors>
    <Product>RemotePC AI</Product>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
