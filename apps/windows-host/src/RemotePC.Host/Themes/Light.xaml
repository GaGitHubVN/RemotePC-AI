<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBgColor">#FFF4F6FB</Color>
    <SolidColorBrush x:Key="WindowBg" Color="#FFF4F6FB"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardBg" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#FFF0F2F9"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FFE3E7F0"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FF111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF6B7280"/>
    <SolidColorBrush x:Key="Accent" Color="#FF4F46E5"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF6366F1"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#224F46E5"/>
    <SolidColorBrush x:Key="Success" Color="#FF16A34A"/>
    <SolidColorBrush x:Key="Warning" Color="#FFD97706"/>
    <SolidColorBrush x:Key="Danger" Color="#FFDC2626"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#22DC2626"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFF8F9FC"/>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4F46E5" Offset="0"/>
        <GradientStop Color="#FF06B6D4" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
