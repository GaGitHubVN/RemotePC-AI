<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBgColor">#FF0F1117</Color>
    <SolidColorBrush x:Key="WindowBg" Color="#FF0F1117"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#FF151824"/>
    <SolidColorBrush x:Key="CardBg" Color="#FF1A1E2C"/>
    <SolidColorBrush x:Key="CardHover" Color="#FF222739"/>
    <SolidColorBrush x:Key="CardBorder" Color="#FF2A3044"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFF1F3F9"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA3B8"/>
    <SolidColorBrush x:Key="Accent" Color="#FF6366F1"/>
    <SolidColorBrush x:Key="AccentHover" Color="#FF7C7FF5"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#336366F1"/>
    <SolidColorBrush x:Key="Success" Color="#FF22C55E"/>
    <SolidColorBrush x:Key="Warning" Color="#FFF59E0B"/>
    <SolidColorBrush x:Key="Danger" Color="#FFEF4444"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#33EF4444"/>
    <SolidColorBrush x:Key="InputBg" Color="#FF12151F"/>
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4F46E5" Offset="0"/>
        <GradientStop Color="#FF06B6D4" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
